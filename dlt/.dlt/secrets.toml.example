# dlt secrets for the ingestion jobs — COMMITTED EXAMPLE.
#
# Copy it to .dlt/secrets.toml, which is gitignored, and fill in one key per job:
#
#   cp .dlt/secrets.toml.example .dlt/secrets.toml
#
# Give each job the bucket's own least-privilege key from ../.env, never the
# root key: the INGEST key for a restricted bucket, the PUBLISHER key for a
# published one. Neither can delete, and the jobs never need to.

# ── example_csv → example-raw (restricted) ───────────────────────────────────
[example_csv.destination.filesystem.credentials]
aws_access_key_id = "<EXAMPLE_RAW_INGEST_KEY from ../.env>"
aws_secret_access_key = "<EXAMPLE_RAW_INGEST_SECRET from ../.env>"
