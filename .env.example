# ─────────────────────────────────────────────────────────────────────────────
# Bedrock — copy to .env and fill in. .env is gitignored and must stay that way.
#
#   cp .env.example .env && make secrets     # generates strong random values
#
# Nothing in this file may ever be committed with a real value in it. The
# bootstrap refuses to run while any credential still reads CHANGE_ME, is
# shorter than 16 characters, or repeats another credential in the file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Where the store listens ──────────────────────────────────────────────────
# Bound to loopback on purpose: an object store must not become reachable on
# the network by accident. Change this only if you mean to.
RUSTFS_BIND_ADDRESS=
RUSTFS_S3_PORT=
RUSTFS_CONSOLE_PORT=

# The endpoint publishers and consumers are handed.
RUSTFS_ENDPOINT_URL=

# ── Optional knobs ───────────────────────────────────────────────────────────
# Both have working defaults in compose.yaml; uncomment only to override.
#
# How much the store logs: error | warn | info | debug | trace.
#RUSTFS_LOG_LEVEL=info
#
# Origins the built-in console may be reached from. The upstream default is
# permissive; compose.yaml narrows it to the loopback console. Nothing
# browser-based is meant to reach this store, so widen it only deliberately.
#RUSTFS_CONSOLE_CORS=http://127.0.0.1:9001

# ── Root credentials ─────────────────────────────────────────────────────────
# The store's superuser. Used by `make bootstrap` and by nothing else, ever.
# No publish job, ingestion job or consumer is given these.
RUSTFS_ROOT_USER=
RUSTFS_ROOT_PASSWORD=

# ── Per-bucket credentials ───────────────────────────────────────────────────
# One key pair per role. Variable names are derived from the BUCKET name in
# bootstrap/buckets.conf, upper-cased with '-' replaced by '_', then the role —
# so the bucket example-publish gives EXAMPLE_PUBLISH_*.
#
#   *_PUBLISHER_*    put/get/list, no delete  -> the write job (published bucket)
#   *_CONSUMER_*     get/list                 -> readers
#   *_CONSUMER_<N>_* get/list                 -> one named extra consumer, from
#                                               buckets.conf's fourth column
#   *_INGEST_*       put/get/list, no delete  -> the ingestion job (restricted bucket)
#
# A write job that can delete is a write job that can destroy the archive,
# which is why writing and reading are two keys and not one.
#
# This list must match what bootstrap/buckets.conf declares. `make secrets`
# reads that file and appends anything missing here, so the shortest way to add
# a bucket is to declare it there and re-run it rather than to edit this block.

# example-publish — PUBLISHED. Safe to hand a consumer key out.
EXAMPLE_PUBLISH_PUBLISHER_KEY=
EXAMPLE_PUBLISH_PUBLISHER_SECRET=
EXAMPLE_PUBLISH_CONSUMER_KEY=
EXAMPLE_PUBLISH_CONSUMER_SECRET=

# example-raw — RESTRICTED. The landing zone for raw source data. There is
# deliberately no consumer key here: the only credential that can read this
# bucket is the ingestion job's, and it cannot delete what it has landed.
EXAMPLE_RAW_INGEST_KEY=
EXAMPLE_RAW_INGEST_SECRET=
